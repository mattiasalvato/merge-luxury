---
interface Feature {
  title: string;
  subtitle: string;
  image: string;
  linkText: string;
  linkHref: string;
}

interface Props {
  left: Feature;
  right: Feature;
}

const { left, right } = Astro.props;
---

<section class="max-w-7xl mx-auto px-6 sm:px-12 py-12 sm:py-16">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
    
    <!-- Feature Sinistra -->
    <div class="flex flex-col group">
      <a href={left.linkHref} class="overflow-hidden aspect-[4/5] block bg-[#ECE8E1]">
        <img 
          src={left.image} 
          alt={left.title} 
          class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-700 ease-out"
          loading="lazy"
        />
      </a>
      <div class="pt-5 space-y-1.5">
        <h3 class="font-serif text-xl sm:text-2xl text-stone-900 font-medium">
          {left.title}
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
          {left.subtitle}
        </p>
        <a 
          href={left.linkHref} 
          class="inline-block text-[10px] tracking-[0.2em] uppercase font-semibold text-stone-950 underline underline-offset-4 hover:text-amber-900 pt-1 transition-colors"
        >
          {left.linkText}
        </a>
      </div>
    </div>

    <!-- Feature Destra -->
    <div class="flex flex-col group">
      <a href={right.linkHref} class="overflow-hidden aspect-[4/5] block bg-[#ECE8E1]">
        <img 
          src={right.image} 
          alt={right.title} 
          class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-700 ease-out"
          loading="lazy"
        />
      </a>
      <div class="pt-5 space-y-1.5">
        <h3 class="font-serif text-xl sm:text-2xl text-stone-900 font-medium">
          {right.title}
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
          {right.subtitle}
        </p>
        <a 
          href={right.linkHref} 
          class="inline-block text-[10px] tracking-[0.2em] uppercase font-semibold text-stone-950 underline underline-offset-4 hover:text-amber-900 pt-1 transition-colors"
        >
          {right.linkText}
        </a>
      </div>
    </div>

  </div>
</section>