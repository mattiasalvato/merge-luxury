---
const slides = [
  {
    tagline: "Collezione Sartoriale",
    title: "Step Into Luxury.\nOwn Every Moment.",
    subtitle: "Dove la maestria artigianale incontra le linee dell'eleganza contemporanea.",
    image: "https://images.unsplash.com/photo-1614252235316-8c857d38b5f4?w=1920&auto=format&fit=crop&q=85",
    ctaText: "Scopri la Collezione",
    ctaLink: "#catalogo",
  },
  {
    tagline: "Nuova Edizione",
    title: "L'Essenza del Comfort\nSenza Tempo.",
    subtitle: "Pellami italiani conciati al vegetale, rifiniti a mano per un'esperienza esclusiva.",
    image: "https://images.unsplash.com/photo-1533867617858-e7b97e060509?w=1920&auto=format&fit=crop&q=85",
    ctaText: "Esplora i Modelli",
    ctaLink: "#catalogo",
  }
];
---

<section class="relative w-full min-h-[85svh] max-h-[920px] bg-[#121110] overflow-hidden select-none flex flex-col justify-end pt-24 pb-16">
  <div id="hero-slider" class="absolute inset-0">
    {slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
        data-slide-index={index}
      >
        <img 
          src={slide.image} 
          alt={slide.title} 
          class="w-full h-full object-cover object-center filter brightness-[0.78] contrast-[1.05]"
          loading={index === 0 ? "eager" : "lazy"}
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-black/30 md:bg-gradient-to-r md:from-black/85 md:via-black/30 md:to-transparent"></div>

        <div class="absolute inset-0 max-w-7xl mx-auto px-6 sm:px-12 flex flex-col justify-end pb-20 sm:pb-24">
          <div class="max-w-xl space-y-4 sm:space-y-6">
            <p class="text-[10px] sm:text-xs uppercase tracking-[0.35em] text-amber-200/90 font-medium">
              {slide.tagline}
            </p>

            <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-stone-100 tracking-tight leading-[1.12] whitespace-pre-line">
              {slide.title}
            </h1>

            <p class="text-xs sm:text-base text-stone-300 font-light max-w-md leading-relaxed">
              {slide.subtitle}
            </p>

            <div class="pt-2">
              <a 
                href={slide.ctaLink}
                class="inline-block bg-white text-stone-950 hover:bg-stone-100 text-[11px] sm:text-xs font-semibold tracking-wider uppercase px-8 py-3.5 rounded-full shadow-xl transition-all duration-300 active:scale-95"
              >
                {slide.ctaText}
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Paginazione 01 / 02 -->
  <div class="relative z-20 max-w-7xl mx-auto px-6 sm:px-12 w-full flex justify-end">
    <div class="flex items-center gap-4 text-xs font-mono text-stone-400">
      {slides.map((_, idx) => (
        <button 
          type="button"
          data-indicator-index={idx}
          class={`hero-num-btn transition-colors duration-300 cursor-pointer ${idx === 0 ? 'text-white font-bold underline underline-offset-4' : 'text-stone-500 hover:text-stone-300'}`}
        >
          0{idx + 1}
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  let current = 0;
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const numBtns = document.querySelectorAll<HTMLElement>('.hero-num-btn');
  let intervalId: ReturnType<typeof setInterval>;

  function showSlide(index: number) {
    if (!slides.length) return;
    current = (index + slides.length) % slides.length;

    slides.forEach((slide, i) => {
      if (i === current) {
        slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
      }
    });

    numBtns.forEach((btn, i) => {
      btn.className = i === current
        ? 'hero-num-btn transition-colors duration-300 cursor-pointer text-white font-bold underline underline-offset-4'
        : 'hero-num-btn transition-colors duration-300 cursor-pointer text-stone-500 hover:text-stone-300';
    });
  }

  function startAuto() {
    intervalId = setInterval(() => showSlide(current + 1), 7000);
  }

  numBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      clearInterval(intervalId);
      showSlide(idx);
      startAuto();
    });
  });

  startAuto();
</script>